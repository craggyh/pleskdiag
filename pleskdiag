                print("  SECURITY ALERT [HIGH]: suspicious PHP/webshell-style paths were active during sampling; verify filesystem and response status immediately.")
            if live["patterns"].get("Action Scheduler async runner", 0) and php.get("avg_cpu", 0) >= 50:
                print("  HIGH CONFIDENCE: long-lived Action Scheduler work overlaps with heavy PHP CPU.")
            if live["patterns"].get("Events Calendar/archive", 0) >= 2 and php.get("avg_cpu", 0) >= 20:
                print("  HIGH CONFIDENCE: Events Calendar/archive crawling overlaps with PHP load.")
            if live["patterns"].get("WordPress login/admin", 0) >= 3:
                print("  WARNING: repeated WordPress login/admin activity observed live.")

    print("\nROOT-CAUSE CANDIDATES\n---------------------")
    candidates = []
    for row in data["traffic"]:
        php = data["php_sampled"].get(row["domain"], {})
        live = data.get("live_requests", {}).get(row["domain"], {})
        avg_cpu, peak_cpu = php.get("avg_cpu", 0.0), php.get("peak_cpu", 0.0)
        security_bonus = 75.0 if live.get("patterns", {}).get("Suspicious PHP/webshell-style path", 0) else 0.0
        score = avg_cpu + security_bonus + min(live.get("unique_requests", 0) * 3.0, 50.0) + \
                min(sum(live.get("patterns", {}).values()) * 2.0, 50.0) + \
                min(row["xmlrpc_requests"] * 2.0, 100.0) + min(row["errors_5xx"], 50)
        if avg_cpu >= 10 or peak_cpu >= 30 or row["xmlrpc_requests"] >= 5 or row["errors_5xx"] >= 5 or security_bonus:
            candidates.append((score, row, php, live))
    for score, row, php, live in sorted(candidates, reverse=True, key=lambda x: x[0])[:8]:
        print("\n{}".format(row["domain"]))
        print("  OBSERVED: PHP CPU avg {:.1f}% peak {:.1f}%; peak workers {}; PIDs seen {}".format(
            php.get("avg_cpu", 0.0), php.get("peak_cpu", 0.0), php.get("peak_workers", 0),
            php.get("workers_seen", 0)))
        print("  Requests: total {}   application {} ({:.1f}/min)   static {}   redirects {}".format(
            row["requests"], row["application_requests"], row["application_rate_per_min"],
            row["static_requests"], row["redirect_requests"]))
        print("  Errors: 4xx {}   5xx {}   XML-RPC {}".format(
            row["errors_4xx"], row["errors_5xx"], row["xmlrpc_requests"]))
        if live:
            print("  LIVE: {} unique active requests; peak concurrent {}; seen in {}/{} samples".format(
                live.get("unique_requests", 0), live.get("peak_concurrent", 0),
                live.get("samples_with_requests", 0), php.get("samples", 0)))
            if live.get("patterns"):
                print("  LIVE PATTERNS: " + ", ".join("{}={}".format(k, v) for k, v in
                      sorted(live["patterns"].items(), key=lambda x: x[1], reverse=True)))
            for req in live.get("requests", [])[:5]:
                print("    {:>3}s {:<15} {:<5} {}".format(
                    req["max_ss"], req["client"][:15], req["method"][:5], req["url"][:68]))
        print("  Application concentration: top IP {:.1f}%   top 5 IPs {:.1f}%".format(
            row["application_top_ip_percent"], row["application_top5_ip_percent"]))
        if row["application_urls"]:
            print("  Top completed application/page requests:")
            for (method, url), count in row["application_urls"][:6]:
                print("    {:>5}  {:<5} {}".format(count, method, url[:75]))
        if row["xmlrpc_requests"]:
            print("  XML-RPC top IPs: " + ", ".join("{} ({})".format(ip, count) for ip, count in row["xmlrpc_ips"]))
        avg = php.get("avg_cpu", 0.0)
        app = row["application_requests"]
        patterns = live.get("patterns", {}) if live else {}
        if patterns.get("Suspicious PHP/webshell-style path", 0):
            print("  SECURITY ALERT [HIGH]: suspicious PHP/webshell-style requests observed live. This is a compromise/probe signal; filesystem existence and HTTP status must be checked before attributing CPU causation.")
        if avg >= 50 and patterns.get("Action Scheduler async runner", 0):
            print("  LIKELY CAUSE [HIGH]: Action Scheduler async processing overlaps with sustained PHP CPU.")
        elif avg >= 20 and patterns.get("Events Calendar/archive", 0) >= 2:
            print("  LIKELY CAUSE [HIGH]: live Events Calendar/archive crawling overlaps with PHP workload.")
        elif avg >= 50 and live.get("unique_requests", 0):
            print("  CORRELATED [MEDIUM]: active Apache application requests overlap with sustained PHP CPU.")
        elif avg >= 50 and app:
            print("  CORRELATED [LOW]: sustained PHP CPU overlaps with completed application requests.")
            print("  CAUSATION: not proven; live request evidence was insufficient.")
        elif avg >= 50:
            print("  UNEXPLAINED: high PHP CPU with no matching completed or live application request captured.")
            print("  NEXT: investigate background CLI/cron/database work or increase live sampling duration.")

    print("\nSUSPICIOUS REQUESTS\n-------------------")
    for row in data["traffic"]:
        if row["attacks"]:
            print("{}: {}".format(row["domain"], ", ".join(
                "{} ({})".format(k, v) for k, v in row["attacks"].items())))


def main():
    parser = argparse.ArgumentParser(prog="pleskdiag", description=APP_NAME)
    parser.add_argument("command", nargs="?", choices=["scan", "export", "publish"], default="scan")
    parser.add_argument("--minutes", type=int, default=15)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--repo", help="diagnostics git checkout (default: /opt/webcore-diagnostics)")
    parser.add_argument("--archive", help="local archive root (default: /var/log/pleskdiag)")
    parser.add_argument("--version", action="version", version="%(prog)s {}".format(version()))
    args = parser.parse_args()
    require_root()
    if args.minutes < 1 or args.minutes > 1440:
        parser.error("--minutes must be between 1 and 1440")

    data = snapshot(args.minutes)
    if args.command == "publish":
        try:
            from pleskdiag_publish import publish
            result = publish(data, report, repo_path=args.repo, archive_root=args.archive)
        except Exception as exc:
            raise SystemExit("Publish failed: {}".format(exc))
        print("Published PleskDiag scan")
        print("  Commit:  {}".format(result["commit"]))
        print("  Repo:    {}".format(result["repo_path"]))
        print("  Archive: {}".format(result["archive_path"]))
    elif args.command == "export" or args.json:
        print(json.dumps(data, indent=2))
    else:
        report(data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
